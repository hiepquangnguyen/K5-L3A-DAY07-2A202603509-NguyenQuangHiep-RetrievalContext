# OpenAI API configuration (do not commit real keys in .env)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ADVANCED_EMBEDDING_MODEL=text-embedding-3-large

# Optional: Day 6 vector store & OpenRouter fallback (only if keeping OpenRouter proxy for Day 6 queries)
DAY6_PROJECT_DIR=../K5-L3A-DAY06-NguyenQuangHiep-2A202603509-DataIngestion
DAY6_QDRANT_PATH=../K5-L3A-DAY06-NguyenQuangHiep-2A202603509-DataIngestion/starter/qdrant_db
DAY6_COLLECTION_NAME=day06_moet_chunks
DAY6_STRATEGY=C
